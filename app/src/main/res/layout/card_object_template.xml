<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:padding="20dp"
    android:background="@drawable/square"
    android:elevation="1dp">

    <com.example.structuremonitoringsystem.OpenGL.OpenGLView
        android:layout_width="200dp"
        android:layout_height="170dp"
        android:layout_alignParentEnd="true"
        android:id="@+id/openGLView"/>

    <TextView
        android:textSize="30sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/thickness"
        android:text="Thckness"/>

    <TextView
        android:textSize="30sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/height"
        android:text="Height"
        android:layout_below="@id/thickness"/>

    <TextView
        android:textSize="30sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/width"
        android:layout_below="@+id/height"
        android:text="Width"/>

    <TextView
        android:textSize="30sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/tempName"
        android:layout_below="@+id/width"
        android:text="Template Name"/>

</RelativeLayout>