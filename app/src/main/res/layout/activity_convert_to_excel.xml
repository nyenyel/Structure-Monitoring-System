<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ConvertToExcel"
    android:fitsSystemWindows="true"
    tools:openDrawer="">

    <com.google.android.material.navigation.NavigationView
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:id="@+id/navbarView"
        app:headerLayout="@layout/navbar_header"
        app:menu="@menu/navbar"
        android:layout_gravity="start"
        android:background="@drawable/bg_square_with_no_edge"/>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <RelativeLayout
            android:id="@+id/toolbarHolder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">


            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="Excel"
                app:titleTextColor="@color/txt_color" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/saveBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/toolbarHolder"
            android:layout_margin="15dp"
            android:background="@drawable/shape_square_btn"
            android:padding="20dp">

            <RelativeLayout
                android:layout_centerInParent="true"
                android:layout_width="wrap_content"
                android:padding="30dp"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_centerVertical="true"
                    android:id="@+id/ic"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_excel_white"
                    android:layout_marginEnd="20dp"/>

                <TextView
                    android:layout_toRightOf="@+id/ic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/bold"
                    android:text="Save Data to Excel"
                    android:textSize="40sp"
                    android:textColor="@color/white" />
            </RelativeLayout>

        </RelativeLayout>


        <RelativeLayout
            android:id="@+id/clearBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/saveBtn"
            android:layout_margin="15dp"
            android:background="@drawable/shape_square_btn_red"
            android:padding="20dp">

            <RelativeLayout
                android:layout_centerInParent="true"
                android:layout_width="wrap_content"
                android:padding="30dp"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_centerVertical="true"
                    android:id="@+id/ic2"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_warning_white"
                    android:layout_marginEnd="20dp"/>

                <TextView
                    android:layout_toRightOf="@+id/ic2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/bold"
                    android:text="Reset Saved Data"
                    android:textSize="35sp"
                    android:textColor="@color/white" />
            </RelativeLayout>

        </RelativeLayout>
    </RelativeLayout>

</androidx.drawerlayout.widget.DrawerLayout>