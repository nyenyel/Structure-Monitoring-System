<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".DeviceSetup">

  <RelativeLayout
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:padding="20dp"
      android:layout_centerInParent="true">

      <TextView
          android:id="@+id/text"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Please identify your first Device!"
          android:fontFamily="@font/extra_bold"
          android:textSize="30sp"
          android:textColor="@color/txt_color"
          />

    <RelativeLayout
        android:id="@+id/zeroCol"
        android:layout_below="@+id/text"
        android:layout_width="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_height="wrap_content">
      <RelativeLayout
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:elevation="1dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Device Name"
            android:padding="1dp"
            android:background="@drawable/bg_square_with_no_edge"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/bold"
            android:textColor="@color/txt_color"
            />
      </RelativeLayout>
      <EditText
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:paddingStart="15dp"
          android:paddingTop="5dp"
          android:paddingBottom="5dp"
          android:layout_marginTop="10dp"
          android:inputType="text"
          android:id="@+id/deviceName"
          android:hint="Device Name"
          android:fontFamily="@font/regular"
          android:textColor="@color/txt_color"
          android:background="@drawable/shape_no_fill"/>
    </RelativeLayout>

    <TextView
        android:layout_below="@+id/zeroCol"
        android:id="@+id/sText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/txt_color"
        android:fontFamily="@font/bold"
        android:layout_marginTop="20dp"
        android:textSize="20sp"
        android:text="Sensors"/>

    <RelativeLayout
        android:id="@+id/firstCol"
        android:layout_below="@+id/sText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
      <RelativeLayout
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:elevation="1dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sensor"
            android:padding="1dp"
            android:background="@drawable/bg_square_with_no_edge"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/bold"
            android:textColor="@color/txt_color"
            />
      </RelativeLayout>

      <TextView
          android:clickable="false"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:paddingStart="15dp"
          android:paddingTop="10dp"
          android:paddingBottom="5dp"
          android:layout_marginTop="10dp"
          android:id="@+id/sensorName"
          android:hint="Sensor Name"
          android:fontFamily="@font/bold"
          android:textColor="@color/txt_color"
          android:background="@drawable/shape_no_fill"/>
    </RelativeLayout>

    <RelativeLayout
        android:visibility="gone"
        android:id="@+id/secondCol"
        android:layout_below="@+id/firstCol"
        android:layout_width="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_height="wrap_content">
      <RelativeLayout
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:elevation="1dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Number of Data"
            android:padding="1dp"
            android:background="@drawable/bg_square_with_no_edge"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/bold"
            android:textColor="@color/txt_color"
            />
      </RelativeLayout>

      <EditText
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:paddingStart="15dp"
          android:paddingTop="5dp"
          android:paddingBottom="5dp"
          android:layout_marginTop="10dp"
          android:inputType="number"
          android:id="@+id/numOfData"
          android:hint="Ex. 3"
          android:fontFamily="@font/regular"
          android:textColor="@color/txt_color"
          android:background="@drawable/shape_no_fill"/>
      <TextView
          android:layout_marginTop="5dp"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_below="@id/numOfData"
          android:textSize="12sp"
          android:fontFamily="@font/italic"
          android:textColor="@color/txt_color"
          android:text="@string/note_sensors"/>
    </RelativeLayout>

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:id="@+id/finishBtn"
        android:layout_below="@+id/secondCol">
      <ImageView
          android:id="@+id/nextImg"
          android:layout_width="40dp"
          android:layout_height="40dp"
          android:src="@drawable/ic_arrow_right"
          android:fontFamily="@font/regular"
          android:textColor="@color/white"
          android:layout_alignParentEnd="true"/>
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:textColor="@color/txt_color"
          android:fontFamily="@font/bold"
          android:textSize="20sp"
          android:text="Finish"
          android:layout_centerVertical="true"
          android:layout_toStartOf="@+id/nextImg"/>
    </RelativeLayout>
  </RelativeLayout>

</RelativeLayout>