<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:id="@+id/layout"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/cancelBtnTwo"
        android:background="@drawable/bg_black_transparent_10"/>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:padding="15dp"
        android:layout_centerInParent="true"
        android:background="@drawable/shape_square">
        <RelativeLayout
            android:id="@+id/holder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/warningIc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_warning"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="30sp"
                android:id="@+id/incorrect"
                android:text="Incorrect PIN"
                android:layout_centerVertical="true"
                android:textColor="@color/txt_color"
                android:fontFamily="@font/bold"/>
        </RelativeLayout>
        <TextView
            android:id="@+id/warningMessage"
            android:layout_marginTop="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/holder"
            android:text="@string/incorrect_warning"
            android:textColor="@color/txt_color"/>
        <TextView
            android:id="@+id/cancelBtn"
            android:layout_width="wrap_content"
            android:layout_below="@+id/warningMessage"
            android:layout_height="wrap_content"
            android:textColor="@color/txt_color"
            android:text="@string/try_again"
            android:layout_marginTop="10dp"
            android:layout_alignParentEnd="true"/>

    </RelativeLayout>

</RelativeLayout>