<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CreateObject"
    android:fitsSystemWindows="true"
    tools:openDrawer="start">

    <com.google.android.material.navigation.NavigationView
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:id="@+id/navbarView"
        android:background="@drawable/bg_square_with_no_edge"
        android:layout_gravity="start"
        app:headerLayout="@layout/navbar_header"
        app:menu="@menu/navbar"/>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.appcompat.widget.Toolbar
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/toolbar"
            app:title="Object Template"/>

        <RelativeLayout
            android:layout_below="@id/toolbar"
            android:layout_width="match_parent"
            android:padding="15dp"
            android:layout_height="match_parent">

            <TextView
                android:id="@id/text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/bold"
                android:textSize="25sp"
                android:text="Create Template"
                android:textColor="@color/txt_color"/>



            <RelativeLayout
                android:id="@+id/firstCol"
                android:layout_below="@+id/text"
                android:layout_width="wrap_content"
                android:layout_marginBottom="10dp"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:elevation="1dp"
                    >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Template Title"
                        android:padding="1dp"
                        android:background="@drawable/bg_square_with_no_edge"
                        android:layout_marginStart="10dp"
                        android:fontFamily="@font/bold"
                        android:textColor="@color/txt_color"
                        />
                </RelativeLayout>
                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="15dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:layout_marginTop="10dp"
                    android:id="@+id/tempName"
                    android:hint="Template Title"
                    android:fontFamily="@font/regular"
                    android:textColor="@color/txt_color"
                    android:background="@drawable/shape_no_fill"/>
            </RelativeLayout>
            <LinearLayout
                android:id="@+id/linearLayout"
                android:layout_below="@+id/firstCol"
                android:layout_width="match_parent"
                android:orientation="horizontal"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:id="@+id/firstInpHolder">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:elevation="1dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Height"
                            android:padding="1dp"
                            android:background="@drawable/bg_square_with_no_edge"
                            android:layout_marginStart="10dp"
                            android:fontFamily="@font/bold"
                            android:textColor="@color/txt_color"/>
                    </RelativeLayout>
                    <EditText
                        android:inputType="number"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="15dp"
                        android:id="@+id/height"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="5dp"
                        android:hint="Height"
                        android:fontFamily="@font/regular"
                        android:textColor="@color/txt_color"
                        android:background="@drawable/shape_no_fill"/>
                </RelativeLayout>
                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:id="@+id/secondInpHolder">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:elevation="1dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Width"
                            android:padding="1dp"
                            android:background="@drawable/bg_square_with_no_edge"
                            android:layout_marginStart="10dp"
                            android:fontFamily="@font/bold"
                            android:textColor="@color/txt_color"/>
                    </RelativeLayout>
                    <EditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="15dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:inputType="number"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="5dp"
                        android:id="@+id/width"
                        android:hint="Width"
                        android:fontFamily="@font/regular"
                        android:textColor="@color/txt_color"
                        android:background="@drawable/shape_no_fill"/>
                </RelativeLayout>
                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:id="@+id/thirdInpHolder">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:elevation="1dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Thickness"
                            android:padding="1dp"
                            android:background="@drawable/bg_square_with_no_edge"
                            android:layout_marginStart="10dp"
                            android:fontFamily="@font/bold"
                            android:textColor="@color/txt_color"/>
                    </RelativeLayout>
                    <EditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="15dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:layout_marginTop="10dp"
                        android:inputType="number"
                        android:id="@+id/thickness"
                        android:hint="Thickness"
                        android:fontFamily="@font/regular"
                        android:textColor="@color/txt_color"
                        android:background="@drawable/shape_no_fill"/>
                </RelativeLayout>
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:layout_marginTop="10dp"
                android:layout_alignParentEnd="true"
                android:layout_width="wrap_content"
                android:layout_height="35dp"
                android:background="@drawable/shape_square_btn"
                android:text="save"
                android:id="@+id/showBtn"
                android:textColor="@color/white"
                android:fontFamily="@font/regular"
                android:layout_below="@+id/linearLayout"/>

        </RelativeLayout>
    </RelativeLayout>

</androidx.drawerlayout.widget.DrawerLayout>