<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/drawerLayout"
    tools:context=".Testing.CreateObject"
    android:fitsSystemWindows="true"
    tools:openDrawer="start">

    <com.google.android.material.navigation.NavigationView
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:id="@+id/navbarView"
        app:headerLayout="@layout/navbar_header"
        app:menu="@menu/navbar"
        android:layout_gravity="start"/>


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="10px">

        <EditText
            android:id="@+id/tempName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Template Name"
            android:textColor="@color/black"
            android:inputType="text"
            />
        <EditText
            android:id="@+id/height"
            android:layout_below="@+id/tempName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="height"
            android:textColor="@color/black"
            android:inputType="numberDecimal"
            />
        <EditText
            android:id="@+id/width"
            android:layout_below="@+id/height"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="width"
            android:textColor="@color/black"
            android:inputType="numberDecimal"

            />
        <EditText
            android:layout_below="@id/width"
            android:id="@+id/thickness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="thickness"
            android:textColor="@color/black"
            android:inputType="numberDecimal"
            />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/createObj"
            android:layout_below="@id/thickness"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create Object"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/getData"
            android:layout_below="@id/createObj"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Get Data"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/createPIN"
            android:layout_below="@id/getData"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="create PIN"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/updatePIN"
            android:layout_below="@id/createPIN"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="update pin"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/checkPIN"
            android:layout_below="@id/updatePIN"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="check pin"/>

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_below="@id/checkPIN"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:title="Dashboard"/>
    </RelativeLayout>


</androidx.drawerlayout.widget.DrawerLayout>