<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Testing.BluetoothTerminalTest">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/cancelBtn">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.github.mikephil.charting.charts.LineChart
                android:layout_margin="10dp"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:id="@+id/realtimeSeismographX"/>

            <com.github.mikephil.charting.charts.LineChart
                android:layout_margin="10dp"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:id="@+id/realtimeSeismographY"
                android:layout_below="@+id/realtimeSeismographX"/>

            <com.github.mikephil.charting.charts.LineChart
                android:layout_margin="10dp"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:id="@+id/realtimeSeismographZ"
                android:layout_below="@+id/realtimeSeismographY"/>

            <com.example.structuremonitoringsystem.OpenGL.OpenGLView
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:id="@+id/openGLView"
                android:layout_margin="10dp"
                android:layout_below="@id/realtimeSeismographZ"/>
        </RelativeLayout>
    </ScrollView>

    <androidx.appcompat.widget.AppCompatButton
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="cancel"
        android:layout_centerHorizontal="true"
        android:layout_alignParentBottom="true"
        android:id="@+id/cancelBtn"
        android:layout_marginBottom="20dp"/>

    <androidx.appcompat.widget.AppCompatButton
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="show"
        android:layout_alignParentBottom="true"
        android:id="@+id/showBtn"
        android:layout_marginBottom="20dp"/>
</RelativeLayout>