<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".BluetoothTerminalTest">

    <com.github.mikephil.charting.charts.LineChart
        android:layout_margin="10dp"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:id="@+id/realtimeSeismographX"/>
    <com.github.mikephil.charting.charts.LineChart
        android:layout_margin="10dp"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:id="@+id/realtimeSeismographY"
        android:layout_below="@+id/realtimeSeismographX"/>
    <com.github.mikephil.charting.charts.LineChart
        android:layout_margin="10dp"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:id="@+id/realtimeSeismographZ"
        android:layout_below="@+id/realtimeSeismographY"/>

    <androidx.appcompat.widget.AppCompatButton
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="cancel"
        android:layout_centerHorizontal="true"
        android:layout_alignParentBottom="true"
        android:id="@+id/cancelBtn"
        android:layout_marginBottom="20dp"/>

</RelativeLayout>